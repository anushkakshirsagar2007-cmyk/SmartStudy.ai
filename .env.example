# Required: long random string (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# AI (OpenAI key, or an OpenRouter key starting sk-or-)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
SCANNED_PDF_PAGE_LIMIT=3
# Admin account created by `python init_db.py` (leave password empty to get a random one printed once)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required to accept manual UPI payments. Set this to the account that receives payments.
UPI_ID=
# Production: keep False. Set COOKIE_SECURE=1 when served over HTTPS.
FLASK_DEBUG=False
COOKIE_SECURE=0
MAX_CONTENT_LENGTH=10485760
# Public URL used for email links, sitemap, and canonical tags
SITE_URL=
# Business identity and policy copy shown to users; have these reviewed for your business
BUSINESS_NAME=SmartStudy.ai
CONTACT_EMAIL=support@example.com
REFUND_WINDOW=within 7 days of payment
SUPPORT_EMAIL=
# SMTP: leave SMTP_HOST empty to print outbound messages to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@smartstudy.ai
