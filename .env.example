# Required: long random string (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# OpenRouter API settings (openrouter/free supports text and vision routing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=30
# Required on Vercel for direct, large-file uploads that bypass the function request-body limit.
# Create a private bucket in Supabase Storage; keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=study-documents
# Maximum scanned/image-heavy PDF pages to send for vision analysis (1-50)
SCANNED_PDF_PAGE_LIMIT=20
# Admin account created by `python init_db.py` (leave password empty to get a random one printed once)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required to accept manual UPI payments. Set this to the account that receives payments.
UPI_ID=
# Production: keep False. Set COOKIE_SECURE=1 when served over HTTPS.
FLASK_DEBUG=False
COOKIE_SECURE=0
MAX_CONTENT_LENGTH=4194304
# Public URL used for email links, sitemap, and canonical tags
SITE_URL=
# Business identity and policy copy shown to users; have these reviewed for your business
BUSINESS_NAME=SmartStudy.ai
CONTACT_EMAIL=smartstudyai26@gmail.com
REFUND_WINDOW=within 7 days of payment
SUPPORT_EMAIL=
# SMTP: leave SMTP_HOST empty to print outbound messages to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@smartstudy.ai
